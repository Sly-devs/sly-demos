node_modules
.next
.next-cache
dist
build
out

# Exception: the vendored MCP-Compass server ships its compiled dist/ — that IS
# the package's runtime entry, and there's no build step from the consumer's
# side. Without this the workspace dep resolves to nothing and compass-live's
# demo runner can't spawn the MCP wrapper.
!_mcp-compass/dist
!_mcp-compass/dist/**

# Local env (never commit secrets)
.env
.env.local
.env.*.local
*.env.local
.env.development
.env.production

# Editor / OS
.DS_Store
.vscode
.idea
*.swp
*.swo

# Pnpm
.pnpm-store

# Recording artefacts (the recordings themselves live in compass/videos/)
*.webm
narrate-cache/

# TypeScript incremental build cache
*.tsbuildinfo
