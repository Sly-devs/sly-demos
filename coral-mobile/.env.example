# coral-mobile · sandbox-tenant env
#
# Maya × Compass mobile demo. Borrows USDC against Aave collateral
# through Compass, governed by Sly. Runs at http://localhost:3211.
#
# Get these credentials by signing up for a sandbox tenant at
# https://sandbox.getsly.ai OR by emailing partnerships@getsly.ai for
# the public partnership demo tenant.

SLY_API_URL=https://sandbox.getsly.ai

# Maya story credentials — tenant API key + an agent token. The agent
# is the borrower of record.
MAYA_TENANT_KEY=pk_test_REPLACE_ME
MAYA_AGENT_TOKEN=agent_REPLACE_ME
MAYA_AGENT_ID=00000000-0000-0000-0000-000000000000
MAYA_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
MAYA_OWNER_EOA=0x0000000000000000000000000000000000000000

# Compass — needed to fetch Maya's on-chain Aave position + run the
# governed credit:borrow CLI invocation on approval.
COMPASS_API_KEY_AUTH=REPLACE_ME
COMPASS_BIN=/usr/local/bin/compass

# The Compass-managed Safe (one Safe per --owner). After running a
# couple of borrows the Safe accumulates a balance; surface it on the
# savings card so the user sees the funds arrived.
MAYA_SAFE_ADDRESS=0x0000000000000000000000000000000000000000

# Optional — Base RPC URL. Public default works fine for the read.
# BASE_MAINNET_RPC_URL=https://mainnet.base.org
