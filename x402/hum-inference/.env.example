# hum-inference · sandbox env
#
# Get sandbox credentials at https://sandbox.getsly.ai or email
# partners@getsly.ai for partnership demo tenant credentials
# (agents pre-provisioned, drop-in ready).
#
# To point at production instead of sandbox, set SLY_API_URL=https://api.getsly.ai
# and use a pk_live_… tenant key.

# ── Sly API + tenant ──
SLY_API_URL=https://sandbox.getsly.ai

# ── Agents (one or more agents pre-provisioned on the tenant) ──
HUM_AGENT_ID=00000000-0000-0000-0000-000000000000
HUM_AGENT_TOKEN=agent_REPLACE_ME
HUM_RELAY_AGENT_ID=00000000-0000-0000-0000-000000000000

# ── Accounts (parent accounts the agents live under) ──
HUM_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
HUM_SELLER_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# ── Other ──
HUM_API_KEY=pk_test_REPLACE_ME
HUM_CHAIN=REPLACE_ME
HUM_DEBUG=REPLACE_ME
HUM_PAY_TO=REPLACE_ME
HUM_X402_ENDPOINT_ID=REPLACE_ME
OLLAMA_BASE_URL=https://REPLACE_ME
OPENROUTER_API_KEY=pk_test_REPLACE_ME
