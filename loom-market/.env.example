# loom-market · sandbox-tenant env
#
# Sign up at https://sandbox.getsly.ai for a sandbox tenant,
# OR email partnerships@getsly.ai for the public demo tenant
# credentials.

SLY_API_URL=https://sandbox.getsly.ai
SLY_TENANT_API_KEY=pk_test_REPLACE_ME

# Some demos use the Sly TypeScript SDK + an agent token instead
# of (or in addition to) the tenant key. Check this demo's source
# to see which credentials it reads.

# DEMO_AGENT_TOKEN=agent_REPLACE_ME
# DEMO_AGENT_ID=00000000-0000-0000-0000-000000000000
