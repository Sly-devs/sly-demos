# forum-platform · sandbox env
#
# Get sandbox credentials at https://sandbox.getsly.ai or email
# partners@getsly.ai for partnership demo tenant credentials
# (agents pre-provisioned, drop-in ready).
#
# To point at production instead of sandbox, set SLY_API_URL=https://api.getsly.ai
# and use a pk_live_… tenant key.

# ── Sly API + tenant ──
SLY_API_URL=https://sandbox.getsly.ai

# ── Agents (one or more agents pre-provisioned on the tenant) ──
FORUM_AGENT_ID=00000000-0000-0000-0000-000000000000
FORUM_AGENT_TOKEN=agent_REPLACE_ME
MIRA_AGENT_ID=00000000-0000-0000-0000-000000000000
MIRA_AGENT_TOKEN=agent_REPLACE_ME

# ── Accounts (parent accounts the agents live under) ──
FORUM_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
FORUM_SARAH_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
LUME_FEE_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
MIRA_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
TAX_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# ── Other ──
FORUM_API_KEY=pk_test_REPLACE_ME
FORUM_WALLET_ID=REPLACE_ME
LUME_API_KEY=pk_test_REPLACE_ME
MIRA_MERCHANT_ID=REPLACE_ME
MIRA_WALLET_ID=REPLACE_ME
