# compass-live · sandbox-tenant env
#
# Get these by signing up for a sandbox tenant at https://sandbox.getsly.ai
# OR by emailing partnerships@getsly.ai for credentials to the public
# Sly × Compass partnership demo tenant (shared sandbox, throwaway funds).
#
# Required:
#   - A Sly tenant API key (`pk_test_…`)
#   - Two agents provisioned on that tenant (Earn + Credit) with CDP wallets
#   - A Compass API key for the read-only positions queries
#   - The Supabase URL + service-role key for the tenant (used to
#     mutate per-scenario state — allowlist, scope grants, agent
#     status — between scenario clicks)

NEXT_PUBLIC_API_URL=https://sandbox.getsly.ai
SLY_DEMO_TENANT_API_KEY=pk_test_REPLACE_ME

# Compass Demo agents (provisioned on your sandbox tenant).
# The Earn Agent runs earn:* tools (no step-up scope).
# The Credit Agent runs credit:* + tokenized:* (step-up required).
COMPASS_DEMO_EARN_AGENT_ID=00000000-0000-0000-0000-000000000000
COMPASS_DEMO_EARN_AGENT_EOA=0x0000000000000000000000000000000000000000
COMPASS_DEMO_CREDIT_AGENT_ID=00000000-0000-0000-0000-000000000000
COMPASS_DEMO_CREDIT_AGENT_EOA=0x0000000000000000000000000000000000000000

# Supabase — needed for the demo's per-scenario state setup
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Compass — read-only positions calls during the demo.
# Get yours at https://compasslabs.ai/dashboard.
COMPASS_API_KEY_AUTH=REPLACE_ME
