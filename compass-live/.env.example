# compass-live · sandbox env
#
# Get sandbox credentials at https://sandbox.getsly.ai or email
# partnerships@getsly.ai for partnership demo tenant credentials
# (agents pre-provisioned, drop-in ready).
#
# To point at production instead of sandbox, set SLY_API_URL=https://api.getsly.ai
# and use a pk_live_… tenant key.

# ── Sly API + tenant ──
SLY_DEMO_TENANT_API_KEY=pk_test_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_URL=https://REPLACE_ME

# ── Agents (one or more agents pre-provisioned on the tenant) ──
COMPASS_DEMO_CREDIT_AGENT_EOA=0x0000000000000000000000000000000000000000
COMPASS_DEMO_CREDIT_AGENT_ID=00000000-0000-0000-0000-000000000000
COMPASS_DEMO_EARN_AGENT_EOA=0x0000000000000000000000000000000000000000
COMPASS_DEMO_EARN_AGENT_ID=00000000-0000-0000-0000-000000000000

# ── Other ──
NEXT_PUBLIC_API_URL=https://REPLACE_ME
