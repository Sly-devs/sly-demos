# compass-live · sandbox env
#
# Get sandbox credentials at https://sandbox.getsly.ai or email
# partnerships@getsly.ai for partnership demo tenant credentials
# (agents pre-provisioned, drop-in ready).
#
# To point at production instead of sandbox, set NEXT_PUBLIC_API_URL=https://api.getsly.ai
# and use a pk_live_… tenant key.

# ── Sly API + tenant ──
SLY_DEMO_TENANT_API_KEY=pk_test_REPLACE_ME
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
NEXT_PUBLIC_API_URL=https://sandbox.getsly.ai

# ── Compass agents (provisioned via apps/demo/_seed/seed-compass-demo.ts) ──
COMPASS_DEMO_EARN_AGENT_ID=00000000-0000-0000-0000-000000000000
COMPASS_DEMO_EARN_AGENT_EOA=0x0000000000000000000000000000000000000000
COMPASS_DEMO_CREDIT_AGENT_ID=00000000-0000-0000-0000-000000000000
COMPASS_DEMO_CREDIT_AGENT_EOA=0x0000000000000000000000000000000000000000

# ── Compass CLI ────────────────────────────────────────────────────────
# Both vars are read by the SPAWNED subprocess (demo-agent-client.mjs and
# the vendored @sly_ai/mcp-compass server it connects to), not by the
# Next app directly. They still need to be in this env or the runner
# will fail with "API key missing or invalid" once you click a scenario.
COMPASS_API_KEY_AUTH=REPLACE_ME            # https://www.compasslabs.ai/dashboard
COMPASS_BIN=/usr/local/bin/compass         # absolute path to the installed `compass` binary

# ── Optional overrides ─────────────────────────────────────────────────
# Where the vendored _mcp-compass package lives. The runner auto-discovers
# it by walking up from CWD; only set if your repo layout differs.
# SLY_DEMOS_ROOT=/abs/path/to/sly-demos
