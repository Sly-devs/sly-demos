# compass-live · sandbox env
#
# Get sandbox credentials at https://sandbox.getsly.ai or email
# partnerships@getsly.ai for the pre-provisioned partnership demo tenant.
#
# To point at production instead of sandbox, set NEXT_PUBLIC_API_URL=https://api.getsly.ai
# and use a pk_live_… tenant key.

# ── Sly API + tenant ─────────────────────────────────────────────────
# The only Sly secret you need. The demo's agent picker lists every
# agent on your tenant — no agent IDs to hardcode. Pick an agent in the
# UI, click "Onboard agent" if it's not Compass-ready yet, then run
# scenarios against it.
SLY_DEMO_TENANT_API_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_API_URL=https://sandbox.getsly.ai

# ── Agents (auto-written by `pnpm onboard`) ──────────────────────────
# These four are populated automatically when you run `pnpm onboard` —
# the script appends a fenced block to your .env.local with the agent
# IDs/EOAs the Sly onboarding API returned. The fallbacks here are the
# local-seed UUIDs from `seed-compass-demo.ts` so local-dev (Sly API on
# :4000 with the seed loaded) keeps working without an onboarding call.
NEXT_PUBLIC_COMPASS_AGENT_EARN_ID=565824b1-1fe4-7260-bcf2-7856f6eb007a
NEXT_PUBLIC_COMPASS_AGENT_EARN_EOA=0x9Bed369ecE5aAaC52110Be91fAE0A5aE69BF1BDd
NEXT_PUBLIC_COMPASS_AGENT_CREDIT_ID=3c7812a6-0e45-6149-9e74-d807c33b622e
NEXT_PUBLIC_COMPASS_AGENT_CREDIT_EOA=0x897Fb7B2447a750B5d5d0054c848CF2aB42c04e3

# ── Compass CLI ──────────────────────────────────────────────────────
# The Compass API key is read by the SPAWNED subprocess
# (demo-agent-client.mjs and the vendored @sly_ai/mcp-compass server it
# connects to). The `compass` binary itself is assumed to be on PATH —
# the canonical installer handles that:
#   curl -fsSL https://compasslabs.ai/install.sh | bash
# Set COMPASS_BIN only if you installed it somewhere nonstandard.
COMPASS_API_KEY_AUTH=REPLACE_ME            # https://www.compasslabs.ai/dashboard
# COMPASS_BIN=/usr/local/bin/compass

# ── Optional override ────────────────────────────────────────────────
# Where the vendored _mcp-compass package lives. The runner auto-discovers
# it by walking up from CWD; only set if your repo layout differs.
# SLY_DEMOS_ROOT=/abs/path/to/sly-demos
