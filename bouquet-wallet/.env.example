# bouquet-wallet · sandbox env
#
# Get sandbox credentials at https://sandbox.getsly.ai or email
# partnerships@getsly.ai for partnership demo tenant credentials
# (agents pre-provisioned, drop-in ready).
#
# To point at production instead of sandbox, set SLY_API_URL=https://api.getsly.ai
# and use a pk_live_… tenant key.

# ── Sly API + tenant ──
SLY_API_URL=https://sandbox.getsly.ai

# ── Agents (one or more agents pre-provisioned on the tenant) ──
BOUQUET_AGENT_ID=00000000-0000-0000-0000-000000000000
BOUQUET_AGENT_TOKEN=agent_REPLACE_ME
CORAL_AGENT_ID=00000000-0000-0000-0000-000000000000
CORAL_AGENT_TOKEN=agent_REPLACE_ME
MAYA_AGENT_ID=00000000-0000-0000-0000-000000000000
MAYA_AGENT_TOKEN=agent_REPLACE_ME

# ── Accounts (parent accounts the agents live under) ──
BOUQUET_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
CORAL_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
MAYA_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# ── On-chain addresses ──
MAYA_OWNER_EOA=0x0000000000000000000000000000000000000000

# ── Compass integration ──
COMPASS_API_KEY_AUTH=REPLACE_ME
COMPASS_BIN=/usr/local/bin/compass

# ── Other ──
BOUQUET_API_KEY=pk_test_REPLACE_ME
CORAL_API_KEY=pk_test_REPLACE_ME
MAYA_TENANT_KEY=REPLACE_ME
